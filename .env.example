# Copy this file to .env and fill in real values before running locally.
# On Render (or any host), set these as Environment Variables instead —
# never commit a real .env file to GitHub.

# Get this from MongoDB Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>, <password>, and add your database name before the "?".
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/substate?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional — Render sets this automatically, only needed for local dev if you want a specific port
PORT=3000

# A password for the "Database (demo)" admin page in the app's ⋯ menu.
# Pick any string — you'll be prompted for it in the app the first time
# you open that page. Without this set, the admin page is disabled entirely.
ADMIN_KEY=
